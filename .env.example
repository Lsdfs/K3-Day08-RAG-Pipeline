# OpenRouter API Key (Khuyên dùng cho bài lab - có model free :free)
OPENROUTER_API_KEY=sk-or-v1-...

# Bật 1 khi muốn gọi LLM qua API. Mặc định chatbot dùng các đoạn trích có citation
# để vẫn phản hồi ngay cả khi mạng/API chậm hoặc hết quota.
ENABLE_LLM_GENERATION=0

# RAGAS evaluation (uses official built-in metrics when dependencies/API are available)
EVAL_BACKEND=ragas
RAGAS_STRICT=0
RAGAS_LLM_MODEL=gpt-4o-mini
RAGAS_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI API Key (Tùy chọn - fallback nếu OpenRouter bị 429 rate limit)
# OPENAI_API_KEY=sk-proj-...

# Gemini API Key (Tùy chọn - fallback nếu OpenRouter và OpenAI đều không có/hết quota)
# GEMINI_API_KEY=...

# PageIndex API Key (Tùy chọn - dùng cho Task 8: Vectorless RAG fallback)
# PAGEINDEX_API_KEY=pix_...
# ENABLE_PAGEINDEX_CLOUD=0
# PAGEINDEX_DOC_ID=your_uploaded_document_id
# PAGEINDEX_API_URL=https://api.pageindex.ai
# PAGEINDEX_TIMEOUT_SECONDS=30

# Jina API Key (Tùy chọn - dùng cho Task 7: Cross-encoder reranking via Jina API)
# JINA_API_KEY=jina_...
